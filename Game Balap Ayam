    function updateRacerPosition(prefix, progressRatio) {
      const clamped = Math.max(0, Math.min(1, progressRatio));
      const baseLeft = prefix === 'solo' ? 2 : 1;
      const span = prefix === 'solo' ? 82 : 73;
      const leftPercent = `${(baseLeft + clamped * span).toFixed(1)}%`;
      const wrap = document.getElementById(`${prefix}-racer-wrap`);
      if (wrap) {
        wrap.style.left = leftPercent;
      }

      // Perbarui mini-indikator lawan pada panel sisi sebelahnya saat Mode Battle
      if (prefix === 'b0' || prefix === 'b1') {
        const myIdx = prefix === 'b0' ? 0 : 1;
        const otherIdx = 1 - myIdx;
        const pct = Math.round(clamped * 100);
        const myPlayer = state.players[myIdx];

        const rivalMarker = document.getElementById(`b${otherIdx}-rival-marker`);
        if (rivalMarker) {
          rivalMarker.style.left = leftPercent;
        }
        const rivalBadge = document.getElementById(`b${otherIdx}-rival-badge`);
        if (rivalBadge && myPlayer) {
          rivalBadge.textContent = `${myPlayer.name}: ${pct}%`;
        }
      }
    }

