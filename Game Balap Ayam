        } else {
          textEl.className = 'font-display font-bold text-7xl sm:text-9xl text-amber-300 drop-shadow-[0_10px_0_#b45309] animate-pop-3d';
          SFX.countdown(false);
        }

        i++;
        if (i < steps.length) {
          setTimeout(showStep, 680);
        } else {
          setTimeout(() => {
            overlay.classList.add('hidden');
            state.isCountdown = false;
            onComplete();
          }, 600);
        }
      }

      showStep();
    }

