        'bg-gradient-to-b from-violet-400 to-purple-600 border-white text-white shadow-[0_5px_0_#5b21b6]'
      ];

      const optionsContainer = document.getElementById('solo-options');
      optionsContainer.innerHTML = item.options.map((optText, idx) => `
        <button onclick="handleSoloAnswer(${idx})"
          class="solo-opt-btn btn-3d border-3 rounded-2xl p-2.5 sm:p-3 text-left flex items-center gap-2.5 font-display font-bold text-sm sm:text-lg ${optColors[idx]}">
          <span class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-white text-slate-900 flex items-center justify-center shrink-0 text-sm sm:text-base shadow-xs">
            ${letters[idx]}
          </span>
          <span class="leading-snug">${optText}</span>
        </button>
      `).join('');
    }

    function handleSoloAnswer(chosenIdx) {
      if (state.isCountdown) return;
      const p = state.players[0];
      if (p.locked || p.finished) return;
      p.locked = true;

      const item = p.questions[p.currentIndex];
      const isCorrect = chosenIdx === item.answer;
      const fb = document.getElementById('solo-feedback');
      const btns = document.querySelectorAll('.solo-opt-btn');

      btns.forEach((btn, idx) => {
        btn.disabled = true;
        if (idx === item.answer) {
          btn.className = 'solo-opt-btn border-3 rounded-2xl p-3 sm:p-3.5 text-left flex items-center gap-3 font-display font-bold text-base sm:text-xl bg-gradient-to-b from-emerald-400 to-emerald-600 border-white text-white shadow-[0_5px_0_#064e3b] scale-[1.02]';
        } else if (idx === chosenIdx && !isCorrect) {
          btn.className = 'solo-opt-btn border-3 rounded-2xl p-3 sm:p-3.5 text-left flex items-center gap-3 font-display font-bold text-base sm:text-xl bg-gradient-to-b from-rose-400 to-rose-600 border-white text-white shadow-[0_5px_0_#881337]';
        } else {
          btn.style.opacity = '0.45';
        }
      });

      if (isCorrect) {
        p.correct++;
        p.score += 100;
        SFX.correct();
        fb.textContent = '🎉 MASYA ALLAH, BENAR! Ayam melompat maju! (+100)';
        fb.className = 'my-1.5 px-4 py-2 rounded-2xl text-center font-display font-bold text-sm sm:text-lg border-3 bg-emerald-100 border-emerald-500 text-emerald-900 animate-pop-3d';
        updateRacerPosition('solo', p.correct / state.questionCount);
        triggerChickenAnim('solo', true);
      } else {
        p.wrong++;
        SFX.wrong();
        const letters = ['A', 'B', 'C', 'D'];
        fb.textContent = `💡 YAH, KURANG TEPAT! Jawaban benar: ${letters[item.answer]}. ${item.options[item.answer]}`;
        fb.className = 'my-1.5 px-4 py-2 rounded-2xl text-center font-display font-bold text-xs sm:text-base border-3 bg-rose-100 border-rose-500 text-rose-900 animate-pop-3d';
        triggerChickenAnim('solo', false);
      }

      fb.classList.remove('hidden');
      updateSoloHUD();

      setTimeout(() => {
        p.currentIndex++;
        p.locked = false;
        if (p.currentIndex >= state.questionCount) {
          p.finished = true;
          finishGame();
        } else {
          updateSoloHUD();
          renderSoloQuestion();
        }
      }, isCorrect ? 950 : 1650);
    }

    /* =======================================================================
       11. LOGIKA GAMEPLAY MODE BATTLE (2 PEMAIN KIRI & KANAN)
       ======================================================================= */
    function updateBattleHUD(pIdx) {
      const p = state.players[pIdx];
      const displayNum = Math.min(p.currentIndex + 1, state.questionCount);
      document.getElementById(`b${pIdx}-q-num`).textContent = displayNum;
      document.getElementById(`b${pIdx}-score`).textContent = p.score;
    }

    function renderBattleQuestion(pIdx) {
      const p = state.players[pIdx];
      const qEl = document.getElementById(`b${pIdx}-question-text`);
      const optEl = document.getElementById(`b${pIdx}-options`);
      const fbEl = document.getElementById(`b${pIdx}-feedback`);
      fbEl.classList.add('hidden');

      if (p.currentIndex >= state.questionCount) {
        p.finished = true;
        if (!p.finishTime) p.finishTime = Date.now();
        qEl.innerHTML = `<span class="text-emerald-600 text-xl sm:text-2xl">🎉 SELESAI!</span><br><span class="text-xs sm:text-sm text-slate-600">Menunggu lawan menyelesaikan soal...</span>`;
        optEl.innerHTML = '';
        checkBattleEnd();
        return;
      }

      const item = p.questions[p.currentIndex];
      qEl.textContent = item.q;

      const letters = ['A', 'B', 'C', 'D'];
      const themeBtn = pIdx === 0
        ? 'bg-gradient-to-b from-sky-300 to-sky-500 border-white text-white shadow-[0_4px_0_#0369a1]'
        : 'bg-gradient-to-b from-amber-300 to-amber-500 border-white text-amber-950 shadow-[0_4px_0_#b45309]';

      optEl.innerHTML = item.options.map((optText, idx) => `
        <button onclick="handleBattleAnswer(${pIdx}, ${idx})"
          class="b${pIdx}-opt-btn btn-3d border-2 rounded-xl px-2 py-1.5 sm:py-2 text-left flex items-center gap-1.5 font-display font-bold text-xs sm:text-sm ${themeBtn}">
          <span class="w-5 h-5 sm:w-6 sm:h-6 rounded-md bg-white text-slate-900 flex items-center justify-center shrink-0 text-[11px] sm:text-xs shadow-2xs">
            ${letters[idx]}
          </span>
          <span class="leading-tight">${optText}</span>
        </button>
      `).join('');
    }

    function handleBattleAnswer(pIdx, chosenIdx) {
      if (state.isCountdown) return;
      const p = state.players[pIdx];
      if (p.locked || p.finished) return;
      p.locked = true;

      const item = p.questions[p.currentIndex];
      const isCorrect = chosenIdx === item.answer;
      const fbEl = document.getElementById(`b${pIdx}-feedback`);
      const btns = document.querySelectorAll(`.b${pIdx}-opt-btn`);

      btns.forEach((btn, idx) => {
        btn.disabled = true;
        if (idx === item.answer) {
          btn.className = `b${pIdx}-opt-btn border-2 rounded-2xl px-2.5 py-2 sm:py-2.5 text-left flex items-center gap-2 font-display font-bold text-xs sm:text-base bg-gradient-to-b from-emerald-400 to-emerald-600 border-white text-white shadow-[0_4px_0_#047857]`;
        } else if (idx === chosenIdx && !isCorrect) {
          btn.className = `b${pIdx}-opt-btn border-2 rounded-2xl px-2.5 py-2 sm:py-2.5 text-left flex items-center gap-2 font-display font-bold text-xs sm:text-base bg-gradient-to-b from-rose-400 to-rose-600 border-white text-white shadow-[0_4px_0_#9f1239]`;
        } else {
          btn.style.opacity = '0.45';
        }
      });

      if (isCorrect) {
        p.correct++;
        p.score += 100;
        SFX.correct();
        fbEl.textContent = '✅ BENAR! +100';
        fbEl.className = 'my-1 px-2 py-1 rounded-xl text-center font-display font-bold text-xs sm:text-sm border-2 bg-emerald-100 border-emerald-500 text-emerald-900';
        updateRacerPosition(`b${pIdx}`, p.correct / state.questionCount);
        triggerChickenAnim(`b${pIdx}`, true);
      } else {
        p.wrong++;
        SFX.wrong();
        const letters = ['A', 'B', 'C', 'D'];
        fbEl.textContent = `❌ Kurang tepat (${letters[item.answer]})`;
        fbEl.className = 'my-1 px-2 py-1 rounded-xl text-center font-display font-bold text-xs sm:text-sm border-2 bg-rose-100 border-rose-500 text-rose-900';
        triggerChickenAnim(`b${pIdx}`, false);
      }

      fbEl.classList.remove('hidden');
      updateBattleHUD(pIdx);

      if (p.correct >= state.questionCount) {
        p.finished = true;
        p.finishTime = Date.now();
        setTimeout(() => finishGame(), 700);
        return;
      }

      setTimeout(() => {
        p.currentIndex++;
        p.locked = false;
        if (p.currentIndex >= state.questionCount) {
          p.finished = true;
          p.finishTime = Date.now();
        }
        updateBattleHUD(pIdx);
        renderBattleQuestion(pIdx);
        checkBattleEnd();
      }, isCorrect ? 750 : 1250);
    }

    function checkBattleEnd() {
      if (state.players[0].finished && state.players[1].finished) {
        setTimeout(() => finishGame(), 500);
      }
    }

    /* =======================================================================
       12. LAYAR HASIL AKHIR (PODIUM 3D BERKONFETI) & RIWAYAT SKOR
       ======================================================================= */
    function spawnConfetti() {
      const container = document.getElementById('confetti-container');
      if (!container) return;
      const colors = ['#facc15', '#38bdf8', '#4ade80', '#fb7185', '#a855f7', '#fb923c'];
      let html = '';
      for (let i = 0; i < 28; i++) {
        const left = Math.random() * 100;
        const delay = (Math.random() * 2.2).toFixed(2);
        const dur = (2.1 + Math.random() * 1.4).toFixed(2);
        const color = colors[i % colors.length];
        html += `<div class="confetti-piece" style="left:${left}%; background:${color}; animation-delay:${delay}s; animation-duration:${dur}s;"></div>`;
      }
      container.innerHTML = html;
    }

    function finishGame() {
      stopTimer();
      SFX.win();
      spawnConfetti();

      const elapsedSec = Math.max(1, Math.floor((Date.now() - state.startTime) / 1000));
      const timeFormatted = formatTime(elapsedSec);
      const pktObj = PACKETS.find(p => p.id === state.packetId);

      document.getElementById('result-subheadline').textContent = `${pktObj.title} (${state.questionCount} Soal)`;
      const bodyEl = document.getElementById('result-body');

      if (state.mode === 'solo') {
        const p = state.players[0];
        const accuracy = Math.round((p.correct / state.questionCount) * 100);
        let titleMsg = `Mumtaz, ${escapeHtml(p.name)}! Luar Biasa! 🌟`;
        if (accuracy < 60) titleMsg = `Terus Semangat Berlatih, ${escapeHtml(p.name)}! 💪`;
        else if (accuracy < 85) titleMsg = `Bagus Sekali, ${escapeHtml(p.name)}! Hebat! 👏`;

        document.getElementById('result-headline').textContent = titleMsg;

        bodyEl.innerHTML = `
          <div class="flex flex-col items-center mb-4">
            <div class="w-24 h-24 chicken-idle-3d z-10">${getChickenSVG(p.color, 'res0')}</div>
            <div class="px-4 h-6 rounded-xl bg-gradient-to-b from-amber-300 to-amber-500 border-2 border-white shadow-[0_4px_0_#b45309] -mt-1 flex items-center justify-center font-display font-bold text-xs text-amber-950">
              🏆 ${escapeHtml(p.name)}
            </div>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="bg-gradient-to-b from-amber-100 to-amber-200 border-3 border-white shadow-[0_4px_0_#f59e0b] rounded-2xl p-3">
              <div class="text-xs font-extrabold text-amber-900">SKOR AKHIR</div>
              <div class="font-display font-bold text-2xl sm:text-3xl text-amber-950 mt-1">${p.score}</div>
            </div>
            <div class="bg-gradient-to-b from-emerald-100 to-emerald-200 border-3 border-white shadow-[0_4px_0_#10b981] rounded-2xl p-3">
              <div class="text-xs font-extrabold text-emerald-900">BENAR / SALAH</div>
              <div class="font-display font-bold text-2xl sm:text-3xl text-emerald-950 mt-1">${p.correct} / ${p.wrong}</div>
            </div>
            <div class="bg-gradient-to-b from-sky-100 to-sky-200 border-3 border-white shadow-[0_4px_0_#0ea5e9] rounded-2xl p-3">
              <div class="text-xs font-extrabold text-sky-900">KETEPATAN</div>
              <div class="font-display font-bold text-2xl sm:text-3xl text-sky-950 mt-1">${accuracy}%</div>
            </div>
            <div class="bg-gradient-to-b from-purple-100 to-purple-200 border-3 border-white shadow-[0_4px_0_#8b5cf6] rounded-2xl p-3">
              <div class="text-xs font-extrabold text-purple-900">WAKTU TEMPUH</div>
              <div class="font-display font-bold text-2xl sm:text-3xl text-purple-950 mt-1">${timeFormatted}</div>
            </div>
          </div>
        `;

        saveHistory({
          mode: 'Solo',
          packet: pktObj.shortTitle,
          detail: `${p.name} • Skor ${p.score} (${p.correct}/${state.questionCount} Benar • ${accuracy}%)`,
          time: timeFormatted,
          date: new Date().toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' })
        });
      } else {
        const p1 = state.players[0];
        const p2 = state.players[1];
        const acc1 = Math.round((p1.correct / state.questionCount) * 100);
        const acc2 = Math.round((p2.correct / state.questionCount) * 100);

        let winnerText = '🤝 HASIL SERI (IMBANG)!';
        if (p1.score > p2.score) {
          winnerText = `🏆 PEMENANG: ${p1.name.toUpperCase()}!`;
        } else if (p2.score > p1.score) {
          winnerText = `🏆 PEMENANG: ${p2.name.toUpperCase()}!`;
        } else if (p1.finishTime && p2.finishTime && p1.finishTime !== p2.finishTime) {
          winnerText = p1.finishTime < p2.finishTime
            ? `🏆 PEMENANG: ${p1.name.toUpperCase()} (LEBIH CEPAT)!`
            : `🏆 PEMENANG: ${p2.name.toUpperCase()} (LEBIH CEPAT)!`;
        }

        document.getElementById('result-headline').textContent = winnerText;

        bodyEl.innerHTML = `
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-left">
            <!-- Kartu Podium Pemain 1 -->
            <div class="bg-gradient-to-b from-sky-100 to-sky-200 border-3 border-white shadow-[0_5px_0_#0284c7] rounded-3xl p-4 flex items-center gap-3">
              <div class="w-16 h-16 shrink-0 chicken-idle-3d">${getChickenSVG(p1.color, 'resb0')}</div>
              <div class="flex-1 min-w-0">
                <div class="font-display font-bold text-lg text-sky-950 truncate">P1 • ${escapeHtml(p1.name)}</div>
                <div class="font-display font-bold text-2xl text-sky-700">Skor: ${p1.score}</div>
                <div class="text-xs font-extrabold text-slate-700 mt-0.5">
                  Benar: ${p1.correct} • Salah: ${p1.wrong} • Akurasi: ${acc1}%
                </div>
              </div>
            </div>

            <!-- Kartu Podium Pemain 2 -->
            <div class="bg-gradient-to-b from-amber-100 to-amber-200 border-3 border-white shadow-[0_5px_0_#d97706] rounded-3xl p-4 flex items-center gap-3">
              <div class="w-16 h-16 shrink-0 chicken-idle-3d" style="animation-delay:0.3s;">${getChickenSVG(p2.color, 'resb1')}</div>
              <div class="flex-1 min-w-0">
                <div class="font-display font-bold text-lg text-amber-950 truncate">P2 • ${escapeHtml(p2.name)}</div>
                <div class="font-display font-bold text-2xl text-orange-700">Skor: ${p2.score}</div>
                <div class="text-xs font-extrabold text-slate-700 mt-0.5">
                  Benar: ${p2.correct} • Salah: ${p2.wrong} • Akurasi: ${acc2}%
                </div>
              </div>
            </div>
          </div>
          <div class="mt-3 text-xs sm:text-sm font-extrabold text-slate-600">
            ⏱️ Total Waktu Pertandingan: ${timeFormatted}
          </div>
        `;

        saveHistory({
          mode: 'Battle 2P',
          packet: pktObj.shortTitle,
          detail: `${p1.name} (${p1.score}) vs ${p2.name} (${p2.score}) • ${winnerText.replace('🏆 ', '')}`,
          time: timeFormatted,
          date: new Date().toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' })
        });
      }

      showScreen('screen-result');
    }

    /* =======================================================================
       13. PENYIMPANAN RIWAYAT SKOR (LOCALSTORAGE)
       ======================================================================= */
    const HISTORY_KEY = 'balap_ayam_pai_kls2_history_v1';

    function saveHistory(entry) {
      try {
        const list = JSON.parse(localStorage.getItem(HISTORY_KEY) || '[]');
        list.unshift(entry);
        localStorage.setItem(HISTORY_KEY, JSON.stringify(list.slice(0, 20)));
      } catch (e) {}
    }

    function openHistoryModal() {
      const container = document.getElementById('history-content');
      let list = [];
      try {
        list = JSON.parse(localStorage.getItem(HISTORY_KEY) || '[]');
      } catch (e) {
        list = [];
      }

      if (list.length === 0) {
        container.innerHTML = `
          <div class="text-center py-8 text-slate-500 font-extrabold">
            Belum ada riwayat balapan. Ayo mulai bermain! 🐔🏁
          </div>
        `;
      } else {
        container.innerHTML = list.map((item, idx) => `
          <div class="bg-sky-50 border-2 border-sky-200 rounded-2xl p-3 flex items-center justify-between gap-3">
            <div>
              <div class="flex items-center gap-2">
                <span class="bg-emerald-500 text-white font-display font-bold text-xs px-2.5 py-0.5 rounded-full">
                  #${idx + 1} • ${item.mode}
                </span>
                <span class="font-display font-bold text-sm text-sky-950">${item.packet}</span>
              </div>
              <div class="text-xs sm:text-sm font-extrabold text-slate-700 mt-1">${item.detail}</div>
            </div>
            <div class="text-right shrink-0 text-xs font-extrabold text-slate-500">
              <div>⏱️ ${item.time}</div>
              <div>${item.date}</div>
            </div>
          </div>
        `).join('');
      }

      openModal('modal-history');
    }

    function clearHistory() {
      SFX.click();
      try {
        localStorage.removeItem(HISTORY_KEY);
      } catch (e) {}
      openHistoryModal();
    }
  </script>
</body>
</html>
