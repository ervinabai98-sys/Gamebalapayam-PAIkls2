        <div class="w-16 hidden sm:block"></div>
      </div>

      <!-- Langkah 1: Kustomisasi Nama & Warna Ayam 3D -->
      <div class="mt-3">
        <h2 class="font-display font-bold text-base sm:text-xl text-sky-950 flex items-center gap-2">
          <span>🎨</span> 1. Atur Nama & Warna Ayam Balapmu:
        </h2>
        <div id="customizer-container" class="grid grid-cols-1 gap-3 mt-2">
          <!-- Diisi via JS -->
        </div>
      </div>

      <!-- Langkah 2: Pilih Paket Latihan PAI Kelas 2 SD -->
      <div class="mt-4">
        <h2 class="font-display font-bold text-base sm:text-xl text-sky-950 flex items-center gap-2">
          <span>📚</span> 2. Pilih Paket Materi Sholat Fardhu (PAI Kelas 2 SD):
        </h2>
        <div id="packet-list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5 mt-2">
          <!-- Diisi via JS -->
        </div>
      </div>

      <!-- Langkah 3: Pilih Jumlah Soal & Tombol MULAI BALAP -->
      <div class="mt-4 pt-3 border-t-2 border-sky-100 flex flex-col sm:flex-row items-center justify-between gap-3">
        <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
          <span class="font-display font-bold text-sm sm:text-lg text-sky-950 mr-1">🔢 Jumlah Soal:</span>
          <button onclick="selectQuestionCount(10)" data-count="10" class="count-btn btn-3d btn-3d-sky text-white font-display font-bold px-4 py-2 rounded-2xl text-sm sm:text-base">
            10 Soal
          </button>
          <button onclick="selectQuestionCount(15)" data-count="15" class="count-btn btn-3d btn-3d-white text-slate-800 font-display font-bold px-4 py-2 rounded-2xl text-sm sm:text-base">
            15 Soal
          </button>
          <button onclick="selectQuestionCount(20)" data-count="20" class="count-btn btn-3d btn-3d-white text-slate-800 font-display font-bold px-4 py-2 rounded-2xl text-sm sm:text-base">
            20 Soal
