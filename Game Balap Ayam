    function runCountdown(onComplete) {
      state.isCountdown = true;
      const overlay = document.getElementById('countdown-overlay');
      const textEl = document.getElementById('countdown-text');
      overlay.classList.remove('hidden');

      const steps = ['3', '2', '1', 'MULAI!'];
      let i = 0;

      function showStep() {
        const label = steps[i];
        textEl.textContent = label;
        textEl.classList.remove('animate-pop-3d');
        void textEl.offsetWidth;
        textEl.classList.add('animate-pop-3d');

        if (label === 'MULAI!') {
          textEl.className = 'font-display font-bold text-6xl sm:text-8xl text-emerald-300 drop-shadow-[0_10px_0_#064e3b] animate-pop-3d';
