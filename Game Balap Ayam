      if (!chickenEl) return;

      chickenEl.classList.remove('chicken-idle-3d', 'chicken-jump-3d', 'chicken-wobble-3d');
      if (shadowEl) {
        shadowEl.classList.remove('chicken-shadow-idle', 'chicken-shadow-jump');
      }
      void chickenEl.offsetWidth;

      if (isCorrect) {
        chickenEl.classList.add('chicken-jump-3d');
        if (shadowEl) shadowEl.classList.add('chicken-shadow-jump');

        if (dustZone) {
          const spark = document.createElement('div');
          spark.textContent = '✨⭐';
          spark.className = 'sparkle-burst text-lg sm:text-xl font-bold';
          dustZone.appendChild(spark);
          setTimeout(() => spark.remove(), 700);
        }
      } else {
        chickenEl.classList.add('chicken-wobble-3d');
      }

      setTimeout(() => {
        chickenEl.classList.remove('chicken-jump-3d', 'chicken-wobble-3d');
        chickenEl.classList.add('chicken-idle-3d');
        if (shadowEl) {
          shadowEl.classList.remove('chicken-shadow-jump');
          shadowEl.classList.add('chicken-shadow-idle');
        }
      }, 620);
    }

