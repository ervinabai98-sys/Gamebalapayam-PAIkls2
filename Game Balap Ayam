<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>BALAP AYAM CERDAS 3D - Edisi PAI Kelas 2 SD: Sholat Fardhu</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Nunito:wght@700;800;900&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      font-family: 'Nunito', sans-serif;
      background: #38bdf8;
    }
    .font-display {
      font-family: 'Fredoka', sans-serif;
    }

    /* =====================================================================
       1. LATAR BELAKANG DAYLIGHT 3D SUPER CERAH & SEGAR
       ===================================================================== */
    .scenic-3d-bg {
      background: linear-gradient(
        180deg,
        #0ea5e9 0%,
        #38bdf8 26%,
        #7dd3fc 52%,
        #e0f2fe 73%,
        #86efac 73.5%,
        #4ade80 85%,
        #22c55e 100%
      );
      position: relative;
    }
    /* Izinkan seleksi teks pada input nama pemain */
    input[type="text"] {
      user-select: text;
      -webkit-user-select: text;
    }

    /* Sinar Matahari Hangat Berputar Halus */
    @keyframes sunRaysSpin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    .sun-rays {
      background: repeating-conic-gradient(
        from 0deg,
        rgba(254, 240, 138, 0.32) 0deg 15deg,
        transparent 15deg 30deg
      );
      animation: sunRaysSpin 45s linear infinite;
    }

    /* Awan 3D Fluffy Mengembang */
    @keyframes floatCloud3D {
      0% { transform: translateX(-180px); }
      100% { transform: translateX(calc(100vw + 200px)); }
    }
    .cloud-3d-1 {
      animation: floatCloud3D 34s linear infinite;
      filter: drop-shadow(0 8px 6px rgba(14, 116, 144, 0.16));
    }
    .cloud-3d-2 {
      animation: floatCloud3D 48s linear infinite;
      animation-delay: -16s;
      filter: drop-shadow(0 6px 5px rgba(14, 116, 144, 0.14));
    }

    /* =====================================================================
       2. LINTASAN BALAP PERSPEKTIF 3D NYATA
       ===================================================================== */
    .track-stage-3d {
      perspective: 620px;
      transform-style: preserve-3d;
    }

    .track-plane-3d {
      transform: rotateX(24deg);
      transform-origin: bottom center;
      background:
        linear-gradient(180deg, rgba(255,255,255,0.28) 0%, rgba(255,255,255,0) 35%, rgba(120,53,15,0.18) 100%),
        repeating-linear-gradient(
          90deg,
          #fbbf24 0px,
          #fbbf24 54px,
          #f59e0b 54px,
          #f59e0b 108px
        );
      border-top: 6px solid #fffbeb;
      border-bottom: 10px solid #b45309;
      box-shadow:
        0 14px 24px rgba(21, 128, 61, 0.35),
        inset 0 6px 12px rgba(255, 255, 255, 0.55);
    }

    /* Garis Putih-Emas Menyala di Tengah Lintasan */
    .track-lane-lines {
      background: repeating-linear-gradient(
        90deg,
        #ffffff 0px,
        #ffffff 28px,
        transparent 28px,
        transparent 52px
      );
      height: 5px;
      opacity: 0.85;
      border-radius: 99px;
      box-shadow: 0 2px 4px rgba(180, 83, 9, 0.3);
    }

    /* Pagar Pembatas 3D Putih-Merah/Kuning di Atas Lintasan */
    .fence-3d-rail {
      background: repeating-linear-gradient(
        90deg,
        #ffffff 0px,
        #ffffff 24px,
        #fb7185 24px,
        #fb7185 48px
      );
      border-top: 3px solid #fff1f2;
      border-bottom: 4px solid #be123c;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.18);
    }

    /* Pola Kotak-kotak Garis Finish 3D */
    .checkered-flag-3d {
      background-image:
        linear-gradient(45deg, #0f172a 25%, transparent 25%),
        linear-gradient(-45deg, #0f172a 25%, transparent 25%),
        linear-gradient(45deg, transparent 75%, #0f172a 75%),
        linear-gradient(-45deg, transparent 75%, #0f172a 75%);
      background-size: 16px 16px;
      background-position: 0 0, 0 8px, 8px -8px, -8px 0px;
      background-color: #ffffff;
      box-shadow: 0 0 14px rgba(255, 255, 255, 0.9);
    }

    @keyframes flagWave {
      0%, 100% { transform: skewY(-4deg) scaleX(1); }
      50% { transform: skewY(5deg) scaleX(0.94); }
    }
    .flag-banner-wave {
      transform-origin: left center;
      animation: flagWave 1.4s ease-in-out infinite;
    }

    /* =====================================================================
       3. TOMBOL ARCADE 3D GLOSSY TEBAL (TACTILE 3D UI)
       ===================================================================== */
    .btn-3d {
      position: relative;
      transition: transform 0.1s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.1s ease, filter 0.15s ease;
      cursor: pointer;
      overflow: hidden;
    }
    /* Kilau Glossy di Bagian Atas Tombol */
    .btn-3d::before {
      content: "";
      position: absolute;
      top: 2px;
      left: 6px;
      right: 6px;
      height: 38%;
      border-radius: 999px;
      background: linear-gradient(180deg, rgba(255,255,255,0.65) 0%, rgba(255,255,255,0.08) 100%);
      pointer-events: none;
    }
    .btn-3d:hover {
      filter: brightness(1.04);
      transform: translateY(-2px);
    }
    .btn-3d:active {
      transform: translateY(5px);
    }

    .btn-3d-emerald {
      background: linear-gradient(180deg, #4ade80 0%, #16a34a 100%);
      border: 3px solid #ffffff;
      box-shadow: 0 6px 0 #15803d, 0 10px 18px rgba(21, 128, 61, 0.35);
    }
    .btn-3d-emerald:active {
      box-shadow: 0 1px 0 #15803d;
    }

    .btn-3d-sky {
      background: linear-gradient(180deg, #38bdf8 0%, #0284c7 100%);
      border: 3px solid #ffffff;
      box-shadow: 0 6px 0 #0369a1, 0 10px 18px rgba(3, 105, 161, 0.35);
    }
    .btn-3d-sky:active {
      box-shadow: 0 1px 0 #0369a1;
    }

    .btn-3d-gold {
      background: linear-gradient(180deg, #fde047 0%, #f59e0b 100%);
      border: 3px solid #ffffff;
      box-shadow: 0 6px 0 #b45309, 0 10px 18px rgba(180, 83, 9, 0.32);
    }
    .btn-3d-gold:active {
      box-shadow: 0 1px 0 #b45309;
    }

    .btn-3d-coral {
      background: linear-gradient(180deg, #fb7185 0%, #e11d48 100%);
      border: 3px solid #ffffff;
      box-shadow: 0 6px 0 #9f1239, 0 10px 18px rgba(159, 18, 57, 0.32);
    }
    .btn-3d-coral:active {
      box-shadow: 0 1px 0 #9f1239;
    }

    .btn-3d-white {
      background: linear-gradient(180deg, #ffffff 0%, #f1f5f9 100%);
      border: 3px solid #cbd5e1;
      box-shadow: 0 6px 0 #94a3b8, 0 10px 16px rgba(15, 23, 42, 0.14);
    }
    .btn-3d-white:active {
      box-shadow: 0 1px 0 #94a3b8;
    }

    /* Kartu Panel 3D Putih Cerah Mengilap */
    .card-3d-bright {
      background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
      border: 4px solid #ffffff;
      box-shadow:
        0 10px 0 rgba(14, 116, 144, 0.25),
        0 18px 32px rgba(15, 23, 42, 0.22),
        inset 0 3px 0 rgba(255, 255, 255, 1);
    }

    /* =====================================================================
       4. ANIMASI KARAKTER AYAM 3D, BAYANGAN KONTAK, & PARTIKEL BINTANG
       ===================================================================== */
    @keyframes chickenBounce3D {
      0%, 100% { transform: translateY(0px) scaleX(1.03) scaleY(0.97); }
      50% { transform: translateY(-6px) scaleX(0.97) scaleY(1.04); }
    }
    @keyframes shadowIdle {
      0%, 100% { transform: scale(1); opacity: 0.42; }
      50% { transform: scale(0.84); opacity: 0.26; }
    }

    /* Lompatan Parabolik 3D saat Jawaban Benar */
    @keyframes chickenJump3D {
      0% { transform: translateY(0px) rotate(0deg) scale(1); }
      30% { transform: translateY(-38px) rotate(-12deg) scale(1.15); }
      65% { transform: translateY(-18px) rotate(10deg) scale(1.08); }
      100% { transform: translateY(0px) rotate(0deg) scale(1); }
    }
    @keyframes shadowJump3D {
      0% { transform: scale(1); opacity: 0.45; }
      30% { transform: scale(0.45); opacity: 0.15; }
      65% { transform: scale(0.68); opacity: 0.24; }
      100% { transform: scale(1); opacity: 0.45; }
    }

    @keyframes chickenWobble3D {
      0%, 100% { transform: translateX(0) rotate(0deg); }
      20% { transform: translateX(-8px) rotate(-8deg); }
      40% { transform: translateX(8px) rotate(8deg); }
      60% { transform: translateX(-5px) rotate(-5deg); }
      80% { transform: translateX(5px) rotate(5deg); }
    }

    @keyframes wingFlap3D {
      0%, 100% { transform: rotate(0deg); }
      50% { transform: rotate(-30deg); }
    }

    @keyframes legRunLeft {
      0%, 100% { transform: rotate(-16deg); }
      50% { transform: rotate(18deg); }
    }
    @keyframes legRunRight {
      0%, 100% { transform: rotate(18deg); }
      50% { transform: rotate(-16deg); }
    }

    @keyframes sparkleBurst {
      0% { opacity: 1; transform: scale(0.4) translate(0, 0); }
      100% { opacity: 0; transform: scale(1.55) translate(-28px, -22px); }
    }

    .chicken-idle-3d {
      animation: chickenBounce3D 0.85s ease-in-out infinite;
    }
    .chicken-shadow-idle {
      animation: shadowIdle 0.85s ease-in-out infinite;
    }
    .chicken-jump-3d {
      animation: chickenJump3D 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .chicken-shadow-jump {
      animation: shadowJump3D 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .chicken-wobble-3d {
      animation: chickenWobble3D 0.45s ease-in-out;
    }
    .wing-3d {
      transform-origin: 48% 52%;
      animation: wingFlap3D 0.3s ease-in-out infinite;
    }
    .leg-l {
      transform-origin: 48px 92px;
      animation: legRunLeft 0.32s ease-in-out infinite;
    }
    .leg-r {
      transform-origin: 68px 92px;
      animation: legRunRight 0.32s ease-in-out infinite;
    }
    .sparkle-burst {
      animation: sparkleBurst 0.65s ease-out forwards;
    }

    /* Animasi Pop-in & Konfeti Podium */
    @keyframes popIn3D {
      0% { transform: scale(0.55) translateY(18px); opacity: 0; }
      75% { transform: scale(1.05) translateY(-3px); opacity: 1; }
      100% { transform: scale(1) translateY(0); opacity: 1; }
    }
    .animate-pop-3d {
      animation: popIn3D 0.34s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    @keyframes confettiFall {
      0% { transform: translateY(-20px) rotate(0deg); opacity: 1; }
      100% { transform: translateY(340px) rotate(540deg); opacity: 0; }
    }
    .confetti-piece {
      position: absolute;
      top: -10px;
      width: 12px;
      height: 12px;
      border-radius: 3px;
      animation: confettiFall 2.6s linear infinite;
    }

    .custom-scroll::-webkit-scrollbar {
      width: 7px;
      height: 7px;
    }
    .custom-scroll::-webkit-scrollbar-thumb {
      background: rgba(2, 132, 199, 0.35);
      border-radius: 999px;
    }
  </style>
</head>
<body class="scenic-3d-bg select-none">

  <!-- DEKORASI LATAR BELAKANG 3D CERAH (SINAR MATAHARI & AWAN FLUFFY) -->
  <div class="pointer-events-none fixed inset-0 overflow-hidden z-0">
    <!-- Matahari & Sinar Berputar -->
    <div class="absolute -top-24 -right-24 w-72 h-72 sm:w-96 sm:h-96 rounded-full sun-rays opacity-75"></div>
    <div class="absolute top-4 right-6 w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-gradient-to-b from-yellow-200 to-amber-400 border-4 border-white shadow-[0_0_32px_rgba(253,224,71,0.9)]"></div>

    <!-- Awan 3D 1 -->
    <div class="cloud-3d-1 absolute top-10 left-0">
      <div class="relative w-32 h-11 bg-white rounded-full">
        <div class="absolute -top-5 left-5 w-14 h-14 bg-white rounded-full"></div>
        <div class="absolute -top-3 right-6 w-11 h-11 bg-white rounded-full"></div>
      </div>
    </div>

    <!-- Awan 3D 2 -->
    <div class="cloud-3d-2 absolute top-24 left-0">
      <div class="relative w-28 h-9 bg-white/90 rounded-full">
        <div class="absolute -top-4 left-4 w-12 h-12 bg-white/90 rounded-full"></div>
        <div class="absolute -top-2 right-5 w-9 h-9 bg-white/90 rounded-full"></div>
      </div>
    </div>

    <!-- Siluet Kubah Masjid Cerah di Kejauhan -->
    <div class="absolute bottom-[25%] left-4 sm:left-12 opacity-30 flex items-end gap-1">
      <div class="w-4 h-16 bg-emerald-700 rounded-t-full"></div>
      <div class="w-16 h-12 bg-emerald-600 rounded-t-full"></div>
      <div class="w-4 h-14 bg-emerald-700 rounded-t-full"></div>
    </div>
    <div class="absolute bottom-[25%] right-4 sm:right-12 opacity-30 flex items-end gap-1">
      <div class="w-4 h-14 bg-emerald-700 rounded-t-full"></div>
      <div class="w-16 h-12 bg-emerald-600 rounded-t-full"></div>
      <div class="w-4 h-16 bg-emerald-700 rounded-t-full"></div>
    </div>
  </div>

  <!-- TOMBOL KONTROL POJOK KANAN ATAS (SUARA & MENU) -->
  <div class="fixed top-2 right-2 sm:top-3 sm:right-3 z-50 flex items-center gap-1.5 sm:gap-2">
    <button id="btn-home-top" onclick="confirmBackToMenu()" title="Kembali ke Menu"
      class="hidden btn-3d btn-3d-coral text-white font-display font-bold px-2.5 py-1.5 sm:px-3 sm:py-2 rounded-2xl text-xs sm:text-sm flex items-center gap-1">
      <span>🏠</span><span class="hidden sm:inline">Menu</span>
    </button>
    <button id="btn-audio" onclick="toggleAudio()" title="Suara Aktif/Mati"
      class="btn-3d btn-3d-gold text-amber-950 font-display font-bold w-9 h-9 sm:w-11 sm:h-11 rounded-2xl text-base sm:text-xl flex items-center justify-center">
      🔊
    </button>
  </div>

  <!-- ===================================================================== -->
  <!-- LAYAR 1: HOME / HALAMAN UTAMA                                         -->
  <!-- ===================================================================== -->
  <section id="screen-home" class="relative z-10 w-full h-[100dvh] flex flex-col items-center justify-center p-3 sm:p-6 overflow-y-auto custom-scroll">
    <div class="w-full max-w-4xl card-3d-bright rounded-[2.25rem] p-5 sm:p-8 text-center animate-pop-3d my-auto">
      <!-- Badge Kelas & Mapel -->
      <div class="inline-flex items-center gap-2 bg-gradient-to-r from-emerald-500 to-teal-600 border-3 border-white text-white font-display font-bold text-xs sm:text-base px-4 py-1.5 rounded-full shadow-[0_4px_0_#0f766e] mb-3">
        <span>🕌</span> PENDIDIKAN AGAMA ISLAM (PAI) • KELAS 2 SD
      </div>

      <!-- Judul Utama 3D -->
      <h1 class="font-display font-bold text-3xl sm:text-5xl md:text-6xl text-sky-900 tracking-tight drop-shadow-[0_3px_0_#bae6fd]">
        BALAP AYAM CERDAS 3D
      </h1>
      <div class="inline-block bg-amber-300 border-2 border-amber-500 text-amber-950 font-display font-bold text-sm sm:text-xl px-4 py-1 rounded-2xl mt-2 shadow-xs">
        ✨ Materi Sholat Fardhu & Ketentuannya ✨
      </div>

      <!-- Panggung Pratinjau 2 Karakter Ayam 3D -->
      <div class="my-5 sm:my-6 bg-gradient-to-b from-sky-100 via-emerald-50 to-amber-100 border-3 border-white rounded-3xl p-4 shadow-inner">
        <div class="grid grid-cols-2 gap-4 max-w-xl mx-auto items-end">
          <!-- Pratinjau Pemain 1 -->
          <div class="flex flex-col items-center">
            <div id="home-chicken-1" class="w-24 h-24 sm:w-28 sm:h-28 chicken-idle-3d"></div>
            <div class="w-16 h-3 rounded-full bg-amber-950/25 -mt-2 chicken-shadow-idle"></div>
            <span id="home-label-1" class="mt-2 bg-sky-500 border-2 border-white text-white font-display font-bold text-xs sm:text-sm px-3 py-1 rounded-full shadow-xs">
              Pemain 1: Si Putih
            </span>
          </div>

          <!-- Pratinjau Pemain 2 -->
          <div class="flex flex-col items-center">
            <div id="home-chicken-2" class="w-24 h-24 sm:w-28 sm:h-28 chicken-idle-3d" style="animation-delay: 0.25s;"></div>
            <div class="w-16 h-3 rounded-full bg-amber-950/25 -mt-2 chicken-shadow-idle" style="animation-delay: 0.25s;"></div>
            <span id="home-label-2" class="mt-2 bg-amber-500 border-2 border-white text-amber-950 font-display font-bold text-xs sm:text-sm px-3 py-1 rounded-full shadow-xs">
              Pemain 2: Si Kuning
            </span>
          </div>
        </div>
      </div>

      <!-- Pilihan Mode Utama: SOLO vs BATTLE 2 PEMAIN -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 sm:gap-4 max-w-2xl mx-auto">
        <button onclick="selectMode('solo')" class="btn-3d btn-3d-emerald text-white rounded-3xl p-4 sm:p-5 flex items-center justify-center gap-3.5 text-left">
          <span class="text-3xl sm:text-4xl bg-white/25 w-14 h-14 rounded-2xl flex items-center justify-center shrink-0">🏃‍♂️</span>
          <div>
            <div class="font-display font-bold text-xl sm:text-2xl leading-tight">MODE SOLO</div>
            <div class="text-xs sm:text-sm font-extrabold text-emerald-50">1 Pemain • Latihan ke Finish</div>
          </div>
        </button>

        <button onclick="selectMode('battle')" class="btn-3d btn-3d-sky text-white rounded-3xl p-4 sm:p-5 flex items-center justify-center gap-3.5 text-left">
          <span class="text-3xl sm:text-4xl bg-white/25 w-14 h-14 rounded-2xl flex items-center justify-center shrink-0">⚔️</span>
          <div>
            <div class="font-display font-bold text-xl sm:text-2xl leading-tight">BATTLE 2 PEMAIN</div>
            <div class="text-xs sm:text-sm font-extrabold text-sky-50">2 Siswa • Lomba Layar Terbagi</div>
          </div>
        </button>
      </div>

      <!-- Tombol Panduan & Riwayat Skor -->
      <div class="flex flex-wrap items-center justify-center gap-3 mt-4 sm:mt-5">
        <button onclick="openModal('modal-guide')" class="btn-3d btn-3d-white text-sky-900 font-display font-bold px-5 py-2.5 rounded-2xl text-sm sm:text-base flex items-center gap-2">
          <span>📖</span> Panduan Bermain
        </button>
        <button onclick="openHistoryModal()" class="btn-3d btn-3d-gold text-amber-950 font-display font-bold px-5 py-2.5 rounded-2xl text-sm sm:text-base flex items-center gap-2">
          <span>🏆</span> Riwayat Skor
        </button>
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- LAYAR 2: PERSIAPAN (KUSTOMISASI AYAM, PAKET MATERI, & JUMLAH SOAL)    -->
  <!-- ===================================================================== -->
  <section id="screen-setup" class="hidden relative z-10 w-full h-[100dvh] flex flex-col items-center justify-center p-2.5 sm:p-5 overflow-y-auto custom-scroll">
    <div class="w-full max-w-5xl card-3d-bright rounded-[2rem] p-4 sm:p-6 animate-pop-3d my-auto">
      <!-- Bar Atas Setup -->
      <div class="flex flex-wrap items-center justify-between gap-2 pb-3 border-b-2 border-sky-100">
        <button onclick="showScreen('screen-home')" class="btn-3d btn-3d-white text-slate-800 font-display font-bold px-3.5 py-2 rounded-2xl text-xs sm:text-sm flex items-center gap-1.5">
